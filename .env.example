# --- Service ---
# Only the exact value DEV turns on the Debug UI's /dev/* routes, the live
# trace stream and the seed script. PROD (or no value) = production. Any other
# value (e.g. STAGING) is non-production: live drivers only message SEND_ALLOWLIST.
ENVIRONMENT=DEV
LOG_LEVEL=INFO
PORT=8100

# --- Shared datastores (point these at the SAME infra aidmvcs-be-dev / compose.yml already run) ---
MONGODB_URI=mongodb://localhost:27017/pulse
REDIS_URL=redis://localhost:6379/1
# Use a distinct Redis DB index (here: /1) from the core app's default (/0) so this
# service's queue and keys never collide with the existing BullMQ queues.

# --- Shared secret for the Next.js <-> this service auth boundary (BOTH directions) ---
# Must be set to the SAME value as UPSELL_SERVICE_SHARED_SECRET in aidmvcs-be-dev's
# environment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
UPSELL_SERVICE_SHARED_SECRET=

# --- Calling back into the existing platform ---
AUTOPULSE_API_BASE_URL=http://localhost:3000

# --- Drivers ---
# fake | live   (live = Twilio SMS + SendGrid email; needs the provider settings below)
CHANNEL_DRIVER=fake
# stub | live   (live = aidmvcs-be-dev records every sent message in its conversation screen)
PLATFORM_CLIENT=stub

# --- Model provider ---
# "offline" = the deterministic stand-in (rules, not AI; no key needed). For
# real models: MODEL_EXTRACT=openai:gpt-4o-mini MODEL_COMPOSE=openai:gpt-4o + a key.
OPENAI_API_KEY=
MODEL_EXTRACT=openai:gpt-4o-mini
MODEL_COMPOSE=openai:gpt-4o
# First reply to a new lead: ai (pipeline, template as the 8s fallback) | template
FIRST_REPLY_MODE=ai
# Burst tests only: every offline-model call waits this long (ms), like a real model.
OFFLINE_MODEL_LATENCY_MS=0

# --- Load (architecture §12) ---
# Turns running at once per dealer, and jobs per worker (keep it above the cap).
DEALER_MAX_INFLIGHT=10
WORKER_CONCURRENCY=20
# A busy job is retried after 2s, growing to 10s, up to 300 times (~48 minutes).
BUSY_RETRY_DELAY_S=2
BUSY_RETRY_MAX_DELAY_S=10
BUSY_RETRY_MAX=300

# --- Live providers (CHANNEL_DRIVER=live, Stage 12) ---
# SMS go out from each dealer's own Twilio number; email from the dealer's mailbox,
# reply-to the same mailbox (replies come back through the platform's Mailgun route).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
# Optional: a single authenticated From address, if dealer domains aren't set up in SendGrid.
SENDGRID_FROM_EMAIL=
# Non-production only: the only phone numbers / emails live drivers may message (comma-separated).
SEND_ALLOWLIST=

# --- Delivery webhooks (Stage 10) ---
# The public address Twilio / SendGrid call (their signature covers the URL). Also
# sets Twilio's status callback on every SMS.
PUBLIC_BASE_URL=
# SendGrid: Mail Settings -> Signed Event Webhook -> Verification Key (base64).
# Twilio status callbacks are verified with TWILIO_AUTH_TOKEN above.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
