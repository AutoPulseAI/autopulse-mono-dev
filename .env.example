# --- Model provider ---
OPENAI_API_KEY=

# --- Shared datastores (point these at the SAME infra aidmvcs-be-dev / compose.yml already run) ---
MONGODB_URI=mongodb://localhost:27017/pulse
REDIS_URL=redis://localhost:6379/1
# Use a distinct Redis DB index (here: /1) from the core app's default (/0) so the LangGraph
# checkpointer keyspace never collides with the existing BullMQ queues on the same Redis instance.

# --- Calling back into the existing platform instead of duplicating logic ---
AUTOPULSE_API_BASE_URL=http://localhost:3000

# --- Shared secret for the Next.js <-> this service auth boundary (BOTH directions) ---
# Must be set to the SAME value as UPSELL_SERVICE_SHARED_SECRET in aidmvcs-be-dev's
# environment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
UPSELL_SERVICE_SHARED_SECRET=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Service ---
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8100
