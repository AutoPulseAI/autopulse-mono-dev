stateDiagram-v2
    direction LR
    state "Sales Visit" as SV
    state "SOLD PENDING" as SP
    state "SOLD - DELIVERED<br/>(active, not closed)" as SD
    state "CLOSED LOST" as CL
    state "CLOSED - NO LONGER OWNS" as CN
    state "UNSOLD" as UN
