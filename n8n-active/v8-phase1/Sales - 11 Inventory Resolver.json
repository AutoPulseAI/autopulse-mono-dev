      "position": [0,-100],
      "credentials": {"mongoDb":{"id":"9CSrB6IzzXy9lnfw","name":"MongoDB account"}},
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const base=structuredClone($node['Build Safe Inventory Queries'].json.envelope);const request=base.inventory.request;const exactRows=$items('Find Exact VIN').map(i=>i.json).filter(v=>v&&Object.keys(v).length&&(v.vin||v._id));const modelRows=$input.all().map(i=>i.json).filter(v=>v&&Object.keys(v).length&&(v.make||v.model||v.vin));const summary=v=>({vin:v.vin??null,year:v.year??null,make:v.make??null,model:v.model??null,trim:v.trim??null,body:v.body??null,vehicle_type:v.vehicletype??null,vehicle_class:v.vehicleclass??null,new_used:v.newused??null,title:v.title??null,engine:v.engine??null,transmission:v.transmission??null,drive:v.drive??null,mileage:v.mileage??null,fuel:v.fuel??null,exterior_color:v.exteriorcolor??null,interior_color:v.interiorcolor??null,seats:v.seats??null,price:v.internetprice??null,vdp_url:v.shortUrl??null});const availability=v=>{if(v.sold===true)return false;for(const key of ['available','is_available','active','isActive']){if(typeof v[key]==='boolean')return v[key];}const s=String(v.availability??v.inventory_status??v.status??'').trim().toLowerCase();if(['sold','unavailable','inactive','removed','deleted','out of stock'].includes(s))return false;if(['available','active','in stock','instock'].includes(s))return true;return null;};const exact=exactRows[0]??null;if(exact){const known=availability(exact);base.inventory.exact_vehicle=summary(exact);base.inventory.authoritative_availability=known!==null;if(known===false)base.inventory.status='EXACT_UNAVAILABLE';else{base.inventory.status='EXACT_AVAILABLE';if(known===null)base.inventory.warnings.push('AVAILABILITY_INFERRED_FROM_DOCUMENT_EXISTENCE_FOR_V7_PARITY');}}else if(modelRows.length){base.inventory.status='ALTERNATIVES';base.inventory.alternatives=modelRows.slice(0,3).map(v=>({...summary(v),availability:availability(v)}));if(modelRows.some(v=>availability(v)===null))base.inventory.warnings.push('ALTERNATIVE_AVAILABILITY_FIELD_UNRESOLVED');}else{base.inventory.status='UNKNOWN';base.inventory.warnings.push(request.vin||request.model?'NO_INVENTORY_MATCH':'NO_INVENTORY_KEY');}return [{json:base}];"
      },
      "id": "a99d7c32-2610-43f3-acdd-45ef85760cd8",
      "name": "Resolve Inventory Result",
