      "parameters": {"jsCode":"const envelope=structuredClone($json.envelope);envelope.inventory.status='UNKNOWN';envelope.inventory.required=false;envelope.inventory.warnings.push('INVENTORY_NOT_REQUIRED');return [{json:envelope}];"},
      "id": "34ab7d5f-f148-4387-ad7e-59fbbf3a4834",
