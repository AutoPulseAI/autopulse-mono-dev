    {
      "parameters": {
        "jsCode": "const envelope=structuredClone($json);const v=envelope.intelligence?.vehicle??{};const esc=s=>String(s??'').replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&');const vin=String(v.vin??envelope.context?.lead?.vin??'').trim().toUpperCase();const make=String(v.make??envelope.context?.lead?.make??'').trim();const model=String(v.model??envelope.context?.lead?.model??'').trim();const year=String(v.year??envelope.context?.lead?.year??'').trim();const category=envelope.intelligence?.inquiry?.category??'';const required=!!(vin||model||/Availability|Price|Test Drive/i.test(category));envelope.inventory={status:'UNKNOWN',required,request:{vin:vin||null,make:make||null,model:model||null,year:year||null},exact_vehicle:null,alternatives:[],authoritative_availability:false,warnings:[]};return [{json:{envelope,required,vin_query:JSON.stringify({dealerId:envelope.identity.dealer_id||'__UNRESOLVED__',vin:vin||'__NO_VIN__'}),model_query:JSON.stringify({dealerId:envelope.identity.dealer_id||'__UNRESOLVED__',model:model?{$regex:`^${esc(model)}$`,$options:'i'}:'__NO_MODEL__',...(make?{make:{$regex:`^${esc(make)}$`,$options:'i'}}:{}),...(year?{year}: {})})}}];"
      },
