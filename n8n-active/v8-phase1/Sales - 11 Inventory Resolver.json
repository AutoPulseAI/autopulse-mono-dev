    {
      "parameters": {"jsCode":"const e=structuredClone($json);if(e.inventory?.status==='ALTERNATIVES'){const all=e.inventory.alternatives??[];const usable=all.filter(v=>v.availability!==false);if(!usable.length&&all.length){e.inventory.status='EXACT_UNAVAILABLE';e.inventory.unavailable_matches=all;e.inventory.alternatives=[];e.inventory.warnings.push('ALL_MATCHED_DOCUMENTS_EXPLICITLY_UNAVAILABLE');}else{e.inventory.alternatives=usable;}}return [{json:e}];"},
